# ── Analytics ────────────────────────────────────────────────
# Your existing GA4 Measurement ID (Google Analytics admin, or Site Kit).
# Reusing the same ID keeps your historical data — no reset.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta (Facebook/Instagram) Pixel ID for ad conversion tracking.
# Events Manager -> Data Sources -> your Pixel -> the numeric ID.
# Leave blank to disable the pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=

# Vercel Web Analytics + Speed Insights need no keys — they turn on
# automatically once enabled in the Vercel project (Analytics tab).

# Google Search Console verification token (the content="" value of the
# google-site-verification meta tag). Only needed if you verify via meta tag.
GOOGLE_SITE_VERIFICATION=

# ── Email: contact form + newsletter (Resend) ────────────────
# 1. Create an API key at https://resend.com
# 2. Add + verify the conductor.ng domain in Resend (DNS records)
RESEND_API_KEY=

# Where contact-form messages land (defaults to support@conductor.ng).
CONTACT_TO_EMAIL=support@conductor.ng

# Verified sender address (must be on a Resend-verified domain).
CONTACT_FROM_EMAIL=Conductor site <noreply@conductor.ng>

# Optional: a Resend Audience id — newsletter signups get added to this list.
# If left blank, each signup is emailed to CONTACT_TO_EMAIL instead (nothing lost).
RESEND_AUDIENCE_ID=

# Alternative (or additional) delivery for the contact form + newsletter:
# POST each submission as JSON to a webhook — Google Apps Script (-> Sheet),
# Zapier, Make, n8n, a Slack incoming webhook, etc. The form succeeds if EITHER
# Resend or this webhook is configured and delivers. Server-only (no NEXT_PUBLIC_).
CONTACT_WEBHOOK_URL=

# ── Site ─────────────────────────────────────────────────────
# Public canonical URL (used for metadata/OG). Set to https://conductor.ng in prod.
NEXT_PUBLIC_SITE_URL=https://conductor.ng

# ── Live chat: tawk.to → ClickUp tickets ─────────────────────
# tawk.to dashboard -> Administration -> Chat Widget. The widget URL looks like
# https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID> — copy both halves.
# Leave the property ID blank to disable the chat widget entirely.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# tawk.to -> Administration -> Settings -> Webhooks. Point the webhook at
# https://conductor.ng/api/tawk and enable the Chat Start, Ticket Create and
# Chat Transcript Created events. Paste the webhook's secret key here — every
# request is HMAC-verified against it, so a wrong value silently rejects
# everything with a 401. Server-only.
TAWK_WEBHOOK_SECRET=

# ClickUp personal API token: ClickUp -> avatar -> Settings -> Apps -> API Token.
CLICKUP_API_TOKEN=

# The list chat tickets are filed into — the "Support Inbox" list in the
# Chat Support space. Open the list in ClickUp; the id is the last path
# segment of its URL (.../v/l/li/<LIST_ID>).
CLICKUP_SUPPORT_LIST_ID=

# Who each ticket is assigned to — comma-separated numeric ClickUp user IDs
# (not emails). Leave blank to file tickets unassigned. Get the ids from
# GET https://api.clickup.com/api/v2/team with your token.
CLICKUP_ASSIGNEE_IDS=

# Optional but recommended: with Upstash/Vercel KV configured (the same
# KV_REST_API_URL / KV_REST_API_TOKEN the investor deck uses), the full chat
# transcript is appended to its ticket when the chat ends, and retried webhook
# deliveries stop creating duplicate tickets. Without it, each ticket keeps
# just the opening message.
